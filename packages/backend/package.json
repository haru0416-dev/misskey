{
	"name": "backend",
	"private": true,
	"type": "module",
	"engines": {
		"bun": "^1.4.2"
	},
	"scripts": {
		"start": "bun run compile-config && bun ./built/entry.js",
		"start:inspect": "bun run compile-config && bun --inspect ./built/entry.js",
		"start:test": "NODE_ENV=test bun run compile-config && NODE_ENV=test bun ./built/entry.js",
		"migrate": "bun run compile-config && bun ./built/migration-runner.js up",
		"db:generate": "bun run compile-config && drizzle-kit generate",
		"db:generate:custom": "bun run compile-config && drizzle-kit generate --custom",
		"cli": "bun run compile-config && bun ./built/cli.js",
		"check:connect": "bun run compile-config && bun ./built/cli.js config doctor",
		"compile-config": "bun ./scripts/compile-config.js",
		"build": "rolldown -c",
		"build:unit": "rolldown -c --sourcemap",
		"build:e2e": "MISSKEY_BUILD_E2E=1 rolldown -c",
		"restart": "bun run build && bun run start",
		"dev": "bun run compile-config && bun run --bun rolldown -c --watch",
		"typecheck": "bun ../../scripts/tsc-native.mjs -p test-server --noEmit && bun ../../scripts/tsc-native.mjs -p test --noEmit && bun ../../scripts/tsc-native.mjs -p test-federation --noEmit",
		"lint": "bun run --bun typecheck",
		"test": "bun run --bun build:unit && NODE_ENV=test bun run compile-config && bun ./scripts/run-vitest.js unit",
		"test:e2e": "bun run --bun build:e2e && NODE_ENV=test bun run compile-config && bun ./scripts/run-vitest.js e2e",
		"test:e2e:bun": "bun run --bun build:e2e && NODE_ENV=test bun run compile-config && bun ./scripts/run-e2e-bun.js",
		"test:fed": "NODE_ENV=test bun run compile-config && vitest --config vitest.config.fed.ts",
		"test-and-coverage": "bun run --bun build:unit && NODE_ENV=test bun run compile-config && bun ./scripts/run-vitest.js unit --coverage",
		"test-and-coverage:e2e": "bun run --bun build:e2e && NODE_ENV=test bun run compile-config && bun ./scripts/run-vitest.js e2e --coverage",
		"check-migrations": "bun run compile-config && bun ./built/migration-runner.js check",
		"generate-api-json": "bun run compile-config && bun ./scripts/generate-api-json.js"
	},
	"dependencies": {
		"@kitajs/html": "4.2.13",
		"@misskey-dev/emoji-assets": "17.0.6",
		"@misskey-dev/emoji-data": "17.0.6",
		"@misskey-dev/sharp-read-bmp": "1.3.1",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/core": "2.11.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.222.0",
		"@opentelemetry/instrumentation": "0.222.0",
		"@opentelemetry/instrumentation-host-metrics": "0.5.0",
		"@opentelemetry/instrumentation-runtime-node": "0.35.0",
		"@opentelemetry/resources": "2.11.0",
		"@opentelemetry/sdk-metrics": "2.11.0",
		"@opentelemetry/sdk-trace-base": "2.11.0",
		"@opentelemetry/sdk-trace-node": "2.11.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@simplewebauthn/server": "14.0.2",
		"bullmq": "6.3.8",
		"chardet": "2.2.0",
		"chokidar": "5.0.0",
		"content-disposition": "3.0.0",
		"disposable-email-domains-js": "1.26.0",
		"drizzle-orm": "0.45.3",
		"feed": "6.0.0",
		"file-type": "22.1.1",
		"hono": "4.13.8",
		"hpagent": "1.2.0",
		"i18n": "workspace:*",
		"ioredis": "6.0.0",
		"ipaddr.js": "2.5.0",
		"is-svg": "6.1.0",
		"jsonld": "9.0.0",
		"mfm-js": "workspace:*",
		"mime-types": "3.0.2",
		"misskey-js": "workspace:*",
		"node-html-parser": "9.0.4",
		"nodemailer": "10.0.10",
		"otpauth": "9.5.2",
		"re2js": "2.8.6",
		"rss-parser": "3.13.0",
		"sanitize-html": "2.17.7",
		"semver": "7.8.5",
		"sharp": "0.35.5",
		"slacc": "workspace:*",
		"systeminformation": "5.33.13",
		"web-push": "3.6.7",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@fedify/vocab": "2.3.7",
		"@kitajs/ts-html-plugin": "4.1.4",
		"@types/jsonld": "1.5.15",
		"@types/mime-types": "3.0.1",
		"@types/node": "26.6.2",
		"pg": "8.23.0",
		"@types/pg": "8.23.1",
		"@types/sanitize-html": "2.16.1",
		"@types/semver": "7.8.0",
		"@types/simple-oauth2": "5.0.8",
		"@types/web-push": "3.6.4",
		"@types/ws": "8.18.1",
		"@vitest/coverage-v8": "5.0.1",
		"blurhash": "2.0.5",
		"cbor2": "2.3.0",
		"drizzle-kit": "0.31.11",
		"fast-check": "4.10.2",
		"rolldown": "1.2.9",
		"simple-oauth2": "5.1.0",
		"vite": "8.3.0",
		"vitest": "5.0.1",
		"ws": "8.21.3"
	}
}
