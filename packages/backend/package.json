{
	"name": "backend",
	"main": "./index.js",
	"private": true,
	"type": "module",
	"engines": {
		"bun": "^1.3.14"
	},
	"scripts": {
		"start": "bun run compile-config && bun ./built/entry.js",
		"start:inspect": "bun run compile-config && bun --inspect ./built/entry.js",
		"start:test": "cross-env NODE_ENV=test bun run compile-config && cross-env NODE_ENV=test bun ./built/entry.js",
		"migrate": "bun run compile-config && bun ./built/migration-runner.js up",
		"db:generate": "bun run compile-config && drizzle-kit generate",
		"db:generate:custom": "bun run compile-config && drizzle-kit generate --custom",
		"cli": "bun run compile-config && bun ./built/cli.js",
		"check:connect": "bun run compile-config && bun ./scripts/check_connect.js",
		"compile-config": "bun ./scripts/compile_config.js",
		"build": "rolldown -c",
		"build:unit": "rolldown -c --sourcemap",
		"build:e2e": "rolldown -c --e2e",
		"build:tsc": "tsgo -p tsconfig.json && tsc-alias -p tsconfig.json",
		"watch": "bun run compile-config && bun ./scripts/watch.mjs",
		"restart": "bun run build && bun run start",
		"dev": "bun run compile-config && rolldown -c --watch",
		"typecheck": "tsgo --noEmit && tsgo -p test --noEmit && tsgo -p test-federation --noEmit",
		"lint": "bun run --bun typecheck",
		"test": "bun run --bun build:unit && cross-env NODE_ENV=test bun run compile-config && bun ./scripts/run_unit.js",
		"test:e2e": "bun run --bun build:e2e && cross-env NODE_ENV=test bun run compile-config && bun ./scripts/run_e2e.js",
		"test:fed": "cross-env NODE_ENV=test bun run compile-config && vitest --config vitest.config.fed.ts",
		"test-and-coverage": "bun run --bun build:unit && cross-env NODE_ENV=test bun run compile-config && bun ./scripts/run_unit.js --coverage",
		"test-and-coverage:e2e": "bun run --bun build:e2e && cross-env NODE_ENV=test bun run compile-config && bun ./scripts/run_e2e.js --coverage",
		"check-migrations": "bun run compile-config && bun ./built/migration-runner.js check",
		"generate-api-json": "bun run compile-config && bun ./scripts/generate_api_json.js"
	},
	"optionalDependencies": {
		"slacc-android-arm-eabi": "0.2.0",
		"slacc-android-arm64": "0.2.0",
		"slacc-darwin-arm64": "0.2.0",
		"slacc-darwin-universal": "0.2.0",
		"slacc-darwin-x64": "0.2.0",
		"slacc-freebsd-x64": "0.2.0",
