{
	"name": "backend",
	"private": true,
	"type": "module",
	"engines": {
		"bun": "^1.4.0"
	},
	"scripts": {
		"start": "bun run compile-config && bun ./built/entry.js",
		"start:inspect": "bun run compile-config && bun --inspect ./built/entry.js",
		"start:test": "NODE_ENV=test bun run compile-config && NODE_ENV=test bun ./built/entry.js",
		"migrate": "bun run compile-config && bun ./built/migration-runner.js up",
		"db:generate": "bun run compile-config && drizzle-kit generate",
		"db:generate:custom": "bun run compile-config && drizzle-kit generate --custom",
		"cli": "bun run compile-config && bun ./built/cli.js",
		"check:connect": "bun run compile-config && bun ./scripts/check_connect.js",
		"compile-config": "bun ./scripts/compile_config.js",
		"build": "rolldown -c",
		"build:unit": "rolldown -c --sourcemap",
		"build:e2e": "MISSKEY_BUILD_E2E=1 rolldown -c",
		"restart": "bun run build && bun run start",
		"dev": "bun run compile-config && bun run --bun rolldown -c --watch",
		"typecheck": "bun ../../scripts/tsc-native.mjs -p test-server --noEmit && bun ../../scripts/tsc-native.mjs -p test --noEmit && bun ../../scripts/tsc-native.mjs -p test-federation --noEmit",
		"lint": "bun run --bun typecheck",
		"test": "bun run --bun build:unit && NODE_ENV=test bun run compile-config && bun ./scripts/run_unit.js",
		"test:e2e": "bun run --bun build:e2e && NODE_ENV=test bun run compile-config && bun ./scripts/run_e2e.js",
		"test:e2e:bun": "bun run --bun build:e2e && NODE_ENV=test bun run compile-config && bun ./scripts/run_e2e_bun.js",
		"test:fed": "NODE_ENV=test bun run compile-config && vitest --config vitest.config.fed.ts",
		"test-and-coverage": "bun run --bun build:unit && NODE_ENV=test bun run compile-config && bun ./scripts/run_unit.js --coverage",
		"test-and-coverage:e2e": "bun run --bun build:e2e && NODE_ENV=test bun run compile-config && bun ./scripts/run_e2e.js --coverage",
		"check-migrations": "bun run compile-config && bun ./built/migration-runner.js check",
		"generate-api-json": "bun run compile-config && bun ./scripts/generate_api_json.js"
	},
	"dependencies": {
		"@kitajs/html": "4.2.13",
		"@misskey-dev/emoji-assets": "17.0.6",
		"@misskey-dev/emoji-data": "17.0.6",
		"@misskey-dev/sharp-read-bmp": "1.3.1",
		"@misskey-dev/summaly": "5.5.1",
		"@napi-rs/canvas": "1.0.2",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/auto-instrumentations-node": "0.79.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.221.0",
		"@opentelemetry/resources": "2.10.0",
		"@opentelemetry/sdk-node": "0.221.0",
		"@opentelemetry/sdk-trace-base": "2.10.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@simplewebauthn/server": "13.3.2",
		"archiver": "8.0.0",
		"blurhash": "2.0.5",
		"bullmq": "6.2.0",
		"chalk": "6.0.0",
		"chokidar": "5.0.0",
		"color-convert": "3.1.3",
		"content-disposition": "3.0.0",
		"disposable-email-domains-js": "1.25.0",
		"drizzle-orm": "0.45.2",
		"feed": "6.0.0",
		"file-type": "22.0.2",
		"hono": "4.13.2",
		"hpagent": "1.2.0",
		"i18n": "workspace:*",
		"ioredis": "6.0.0",
		"ipaddr.js": "2.5.0",
		"is-svg": "6.1.0",
		"jsonld": "9.0.0",
		"juice": "12.1.2",
		"meilisearch": "0.60.0",
		"mfm-js": "workspace:*",
		"mime-types": "3.0.2",
		"misskey-js": "workspace:*",
		"node-html-parser": "9.0.1",
		"nodemailer": "9.0.5",
		"otpauth": "9.5.1",
		"pg": "8.23.0",
		"rss-parser": "3.13.0",
		"sanitize-html": "2.17.7",
		"semver": "7.8.5",
		"sharp": "0.35.2",
		"slacc": "workspace:*",
		"systeminformation": "5.31.11",
		"web-push": "3.6.7",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@fedify/vocab": "2.3.1",
		"@kitajs/ts-html-plugin": "4.1.4",
		"@types/archiver": "8.0.0",
		"@types/jsonld": "1.5.15",
		"@types/mime-types": "3.0.1",
		"@types/node": "26.2.0",
		"@types/nodemailer": "8.0.1",
		"@types/pg": "8.23.1",
		"@types/sanitize-html": "2.16.1",
		"@types/semver": "7.8.0",
		"@types/simple-oauth2": "5.0.8",
		"@types/web-push": "3.6.4",
		"@types/ws": "8.18.1",
		"@vitest/coverage-v8": "4.1.11",
		"cbor2": "2.3.0",
		"drizzle-kit": "0.31.10",
		"fast-check": "4.9.0",
		"rolldown": "1.1.3",
		"simple-oauth2": "5.1.0",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"ws": "8.21.3"
	}
}
