{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"watch": "vite",
		"watch:embed": "vite --config vite.embed.config.ts",
		"build": "bun build.ts",
		"catalog": "vite --config vite.catalog.config.ts",
		"catalog:build": "vite build --config vite.catalog.config.ts",
		"test": "vitest --run --globals",
		"test:node": "vitest --run --globals --project node",
		"test:browser": "vitest --run --globals --project browser",
		"test:stories": "vitest --run --config vitest.stories.config.ts",
		"test-and-coverage": "vitest --run --coverage --globals",
		"typecheck": "bun ../../scripts/vue-tsc-bun.cjs --noEmit",
		"lint": "bun run --bun typecheck"
	},
