{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"watch": "vite",
		"build": "bun build.ts",
		"storybook-dev": "bun run --bun build-storybook-pre && storybook dev -p 6006 --ci",
		"build-storybook-pre": "(cd .storybook && bun generate.tsx) && bun .storybook/preload-locale.ts && bun .storybook/preload-theme.ts && tsgo -p .storybook",
		"build-storybook": "bun run --bun build-storybook-pre && storybook build --webpack-stats-json storybook-static",
		"chromatic": "chromatic",
		"test": "vitest --run --globals",
		"test-and-coverage": "vitest --run --coverage --globals",
		"typecheck": "bun ../../scripts/vue-tsc-bun.cjs --noEmit && tsgo -p .storybook/tsconfig.json --noEmit",
		"lint": "bun run --bun typecheck"
	},
	"dependencies": {
