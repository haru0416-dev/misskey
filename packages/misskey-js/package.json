{
	"type": "module",
	"name": "misskey-js",
	"version": "0.1.0",
	"private": true,
	"description": "Misskey SDK for JavaScript",
	"license": "MIT",
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./built/index.d.ts",
			"default": "./built/index.js"
		},
		"./acct.js": {
			"types": "./built/acct.d.ts",
			"default": "./built/acct.js"
		},
		"./api.js": {
			"types": "./built/api.d.ts",
			"default": "./built/api.js"
		},
		"./consts.js": {
			"types": "./built/consts.d.ts",
			"default": "./built/consts.js"
		},
		"./entities.js": {
			"types": "./built/entities.d.ts",
			"default": "./built/entities.js"
		},
		"./langmap.js": {
			"types": "./built/langmap.d.ts",
			"default": "./built/langmap.js"
		},
		"./streaming.types.js": {
			"types": "./built/streaming.types.d.ts",
			"default": "./built/streaming.types.js"
		}
	},
	"scripts": {
		"build": "bun ./build.js",
		"watch": "bun ./build.js --watch",
		"test-d": "bun ../../scripts/tsc-native.mjs -p test-d --noEmit",
		"api": "api-extractor run --local --verbose",
		"api-prod": "api-extractor run --verbose",
		"typecheck": "bun ../../scripts/tsc-native.mjs --noEmit",
		"lint": "bun run --bun typecheck",
		"vitest": "vitest run",
		"test": "MISSKEY_JS_TEST_RUNTIME=bun bun run --bun vitest && bun run --bun test-d",
		"test:node": "MISSKEY_JS_TEST_RUNTIME=node vitest run",
		"update-autogen-code": "bun run --filter misskey-js-type-generator generate && rm -rf src/autogen && cp -R generator/built/autogen src/autogen"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/haru0416-dev/misskey.git",
		"directory": "packages/misskey-js"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "7.59.3",
		"@types/node": "26.6.3",
		"@types/ws": "8.18.2",
		"@vitest/coverage-v8": "5.0.3",
		"esbuild": "0.28.2",
		"vitest": "5.0.3",
		"vitest-websocket-mock": "0.8.0",
		"ws": "8.22.0"
	},
	"files": [
		"built"
	],
	"dependencies": {
		"@simplewebauthn/browser": "14.0.0",
		"eventemitter3": "5.0.4"
	}
}
