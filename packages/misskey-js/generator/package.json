{
	"name": "misskey-js-type-generator",
	"version": "0.0.0",
	"description": "Misskey TypeGenerator",
	"type": "module",
	"scripts": {
		"generate": "bun src/generator.ts && oxfmt --config ./oxfmt.generated.json --ignore-path /dev/null --no-error-on-unmatched-pattern --write built/autogen/*.ts"
	},
	"devDependencies": {
		"@readme/openapi-parser": "6.1.3",
		"@types/node": "26.2.0",
		"openapi-types": "12.1.3",
		"openapi-typescript": "7.13.0",
		"ts-case-convert": "2.3.1",
		"typescript": "6.0.3"
	},
	"files": [
		"built"
	]
}
