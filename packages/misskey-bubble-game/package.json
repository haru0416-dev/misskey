{
	"type": "module",
	"name": "misskey-bubble-game",
	"version": "0.0.1",
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"import": "./built/index.js",
			"types": "./built/index.d.ts",
			"default": "./built/index.js"
		},
		"./*": {
			"import": "./built/*",
			"types": "./built/*",
			"default": "./built/*"
		}
	},
	"scripts": {
		"build": "bun ./build.js",
		"watch": "bun ./build.js --watch",
		"typecheck": "tsgo --noEmit",
		"lint": "bun run --bun typecheck"
	},
	"devDependencies": {
		"@types/matter-js": "0.20.2",
		"@types/node": "26.0.0",
		"@types/seedrandom": "3.0.8",
		"esbuild": "0.28.1",
		"execa": "9.6.1"
	},
	"files": [
		"built"
	],
	"dependencies": {
		"eventemitter3": "5.0.4",
		"matter-js": "0.20.0",
		"seedrandom": "3.0.5"
	}
}
