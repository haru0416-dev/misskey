{
	"name": "i18n",
	"type": "module",
	"private": true,
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"types": "./built/index.d.ts",
			"import": "./built/index.js"
		},
		"./const": {
			"types": "./built/const.d.ts",
			"import": "./built/const.js"
		}
	},
	"scripts": {
		"generate": "bun scripts/generateLocaleInterface.ts",
		"verify": "bun scripts/verify.ts",
		"test": "bun run build && vitest run test",
		"build": "bun ./build.ts",
		"watch": "bun ./build.ts --watch",
		"typecheck": "bun check",
		"lint": "bun run --bun typecheck"
	},
	"files": [
		"built"
	],
	"devDependencies": {
		"@types/node": "26.6.4",
		"chokidar": "5.0.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"typescript-native": "npm:typescript@7.0.2",
		"vitest": "5.0.3"
	}
}
