{
	"name": "i18n",
	"type": "module",
	"private": true,
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"types": "./built/index.d.ts",
			"import": "./built/index.js"
		},
		"./const": {
			"types": "./built/const.d.ts",
			"import": "./built/const.js"
		}
	},
	"scripts": {
		"generate": "bun scripts/generateLocaleInterface.ts",
		"verify": "bun scripts/verify.ts",
		"build": "bun ./build.ts",
		"watch": "bun ./build.ts --watch",
		"tsd": "tsd",
		"typecheck": "tsgo --noEmit",
		"lint": "bun run --bun typecheck"
	},
	"files": [
		"built"
	],
	"devDependencies": {
		"@types/node": "26.0.0",
		"chokidar": "5.0.0",
		"esbuild": "0.28.1"
	},
	"dependencies": {
		"js-yaml": "5.2.1"
	}
}
