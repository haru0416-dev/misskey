{
	"type": "module",
	"name": "misskey-reversi",
	"version": "0.0.1",
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"import": "./built/index.js",
			"types": "./built/index.d.ts",
			"default": "./built/index.js"
		},
		"./*": {
			"import": "./built/*",
			"types": "./built/*",
			"default": "./built/*"
		}
	},
	"scripts": {
		"build": "bun ./build.js",
		"watch": "bun ./build.js --watch",
		"typecheck": "tsgo --noEmit",
		"lint": "bun run --bun typecheck"
	},
	"devDependencies": {
		"@types/node": "26.0.0",
		"esbuild": "0.28.1",
		"execa": "9.6.1"
	},
	"files": [
		"built"
	],
	"dependencies": {
		"crc-32": "1.2.2"
	}
}
