{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "all",
	"printWidth": 120,
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"insertFinalNewline": true,
	"vueIndentScriptAndStyle": false,
	"sortPackageJson": false,
	"ignorePatterns": [
		".agents/**",
		".claude/**",
		".config/**",
		"built/**",
		"built-test/**",
		"chart/**",
		"coverage/**",
		"idea/**",
		"locales/**",
		"node_modules/**",
		"packages/aiscript-languageserver-stub/**",
		"packages/backend/**",
		"packages/frontend-embed/**",
		"packages/i18n/**",
		"packages/icons-subsetter/**",
		"packages/misskey-js/**",
		"packages/sw/**",
		"packages/frontend/**/*.vue",
		"packages/frontend/js-built/**",
		"packages/frontend/assets/**",
		"packages/frontend/public/mockServiceWorker.js"
	]
}
