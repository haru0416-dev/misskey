{
	"name": "Misskey",
	"dockerComposeFile": "compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"features": {
		"ghcr.io/devcontainers-extra/features/bun:1": {
			"version": "1.3.14"
		}
	},
	"forwardPorts": [3000],
	"postCreateCommand": "/bin/bash .devcontainer/init.sh",
	"customizations": {
		"vscode": {
			"extensions": ["editorconfig.editorconfig", "Vue.volar", "mrmlnc.vscode-json5"]
		}
	}
}
