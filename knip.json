{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["check"],
	"ignore": [
		"packages/backend/migration/_legacy/**",
		"packages/backend/assets/**",
		"packages/frontend/assets/**",
		"packages/frontend/catalog/public/**",
		"**/public/**",
		"packages/misskey-js/src/autogen/**",
		"packages/sugar-high/**"
	],
	"workspaces": {
		".": {
			"entry": ["scripts/*.{mjs,cjs,ts}", ".github/scripts/*.{mjs,cjs,mts,ts}"],
			"project": ["scripts/**/*.{mjs,cjs,ts}", ".github/scripts/**/*.{mjs,cjs,mts,ts}"],
			"ignoreDependencies": ["pg", "ioredis"]
		},
		"packages/backend": {
			"entry": [
				"scripts/**/*.{js,mjs,mts,ts}",
				"test/**/*.ts",
				"test-server/**/*.ts",
				"test-federation/**/*.ts",
				"vitest.config.*.ts"
			],
			"ignoreDependencies": ["@misskey-dev/emoji-assets"]
		},
		"packages/frontend": {
			"entry": [
				"src/loader/main.ts",
				"src/loader/embed.ts",
				"src/workers/*.ts",
				"builder/**/*.ts",
				"test/**/*.ts",
				"src/**/*.stories.impl.ts",
				"src/**/*.stories.meta.ts",
				"src/features/image-editor/effects/*.ts",
				"src/stories/*.{ts,vue}",
				"catalog/**/*.{ts,vue}"
			],
			"ignoreDependencies": ["@misskey-dev/emoji-assets", "vue-tsc", "search-index"]
		},
		"packages/sw": {
			"entry": ["src/sw.ts"],
			"ignoreDependencies": ["@typescript/lib-webworker"]
		},
		"packages/misskey-js": {
			"entry": ["test/**/*.ts", "test-d/**/*.ts"]
		},
		"packages/i18n": {
			"entry": ["src/index.ts", "src/const.ts", "scripts/**/*.ts"],
			// build.ts が型定義の生成用に package.json の場所を文字列で解決する
			"ignoreDependencies": ["typescript-native"]
		},
		"packages/icons-subsetter": {
			"ignoreDependencies": ["harfbuzzjs"]
		}
	}
}
